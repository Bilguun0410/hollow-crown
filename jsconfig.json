{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["phaser", "bun"]
  },
  "include": ["src/**/*", "server/**/*.js", "server.js", "public/**/*.d.ts", "tools/**/*.js"],
  "exclude": ["node_modules", "public/vendor"]
}
